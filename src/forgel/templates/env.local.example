# Local Forgel setup. Created by `forgel init`. Never commit .env.local.
#
# The process environment wins over this file. Only FORGEL_* and TELEGRAM_*
# keys are loaded. Deployment settings (SSH, DEPLOY_*) live in .env.deploy
# and are not needed for local work.

# Model: required for planning and code changes. Fill in your key.
FORGEL_MODEL_API_KEY=
FORGEL_MODEL_BASE_URL=https://api.deepseek.com/v1
FORGEL_MODEL_NAME=deepseek-flash
# auto | script | off
FORGEL_MODEL_MODE=auto

# Model spend: off_peak defers work during DeepSeek peak hours (2x rate).
FORGEL_PEAK_POLICY=off_peak
FORGEL_PEAK_HOURS=1-4,6-10
FORGEL_TIMEZONE=

# Task pipeline: independent QA, review, acceptance.
FORGEL_TASK_QA=1
FORGEL_TASK_REVIEW=1
# auto | human
FORGEL_TASK_ACCEPT=human
FORGEL_TASK_RETRIES=5
FORGEL_TASK_REWORKS=8
FORGEL_FREE_TEXT_SPEC=1
FORGEL_TASK_RETRY_BACKOFF=1,5,15,30,60
FORGEL_TASK_ARBITER=1
# quarantine | stop | continue
FORGEL_PLAN_ON_FAILURE=quarantine

# GitHub: needed to publish branches, open PRs and create repositories.
# A GitHub App is preferred; a fine-grained PAT works for the first run.
FORGEL_GITHUB_ORG=forgel-dev
FORGEL_GITHUB_TOKEN=
FORGEL_GITHUB_APP_ID=
FORGEL_GITHUB_INSTALLATION_ID=
FORGEL_GITHUB_APP_PRIVATE_KEY_PATH=

# local runs project code in this process; docker uses the per-project sandbox.
FORGEL_SANDBOX=local
# FORGEL_SANDBOX=docker
# FORGEL_SANDBOX_HOST=tcp://127.0.0.1:2375
# FORGEL_SANDBOX_PROJECTS_ROOT=
# FORGEL_SANDBOX_IMAGE=
# none | bridge
# FORGEL_SANDBOX_NETWORK=none

# Telegram is optional for the local client; needed for `forgel telegram`.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_CHAT_IDS=
