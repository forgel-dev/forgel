# Placeholder values for the local docker compose stand.
#
# Copy to .env before `docker compose up --build` and replace the placeholders.
# Never commit a real credential.

# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# Postgres. The API reads DATABASE_URL, or the discrete POSTGRES_* values.
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# S3-compatible object storage (MinIO locally).
S3_ENDPOINT=http://minio:9000
S3_BUCKET=app-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# MinIO server image; override it to pin a release or to use another registry.
MINIO_IMAGE=bitnamilegacy/minio:latest

# Host ports of the compose services.
API_PORT=8000
S3_PORT=9000
S3_CONSOLE_PORT=9001
