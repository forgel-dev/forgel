# Telegram gateway. The bot is closed by default: both values are required.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric chat ids that may issue commands, e.g. 123456789
TELEGRAM_ALLOWED_CHAT_IDS=
# Optional long-polling timeout in seconds (default: daemon config, then 25).
TELEGRAM_POLL_TIMEOUT=

# local = single-tenant, in-process; docker = per-project sandbox.
FORGEL_SANDBOX=local
# Point the docker sandbox at a separate daemon: a remote engine or the DinD
# sidecar from `docker compose --profile sandbox up`.
# FORGEL_SANDBOX_HOST=tcp://sandbox:2375
# Path where that daemon sees $FORGEL_HOME/projects (the sidecar mount point).
# FORGEL_SANDBOX_PROJECTS_ROOT=/sandbox-data/projects
# Base image for projects without environment.yaml.
# FORGEL_SANDBOX_IMAGE=
# none | bridge
# FORGEL_SANDBOX_NETWORK=none

# Project agent. The key may also come from `forgel secret set model.api_key`.
FORGEL_MODEL_API_KEY=
FORGEL_MODEL_BASE_URL=https://api.deepseek.com/v1
FORGEL_MODEL_NAME=deepseek-flash
# auto | script | off. "script" reads $FORGEL_HOME/model-script.json for local tests.
FORGEL_MODEL_MODE=auto
# Context budget for coding tasks; long tasks hand off between sessions.
FORGEL_CONTEXT_WINDOW=1000000
# Maximum sessions per task (each session may hit its own step cap).
FORGEL_AGENT_MAX_SESSIONS=6
# Run the environment contract again after the agent, as independent QA.
FORGEL_TASK_QA=1
# Tokenizer: auto uses tiktoken when installed; heuristic forces the fallback.
FORGEL_TOKENIZER=auto
# Model spend: off_peak (default) defers work during DeepSeek peak hours;
# always allows peak rates. Hours are UTC weekday windows.
FORGEL_PEAK_POLICY=off_peak
FORGEL_PEAK_HOURS=1-4,6-10
# Your zone for the times shown in /peak and deferral messages.
FORGEL_TIMEZONE=

# GitHub. PAT is the M0.5 bootstrap; a GitHub App is preferred.
FORGEL_GITHUB_TOKEN=
FORGEL_GITHUB_APP_ID=
FORGEL_GITHUB_INSTALLATION_ID=
# Either inline PEM (newlines allowed in env) or a mounted 0600 file path.
FORGEL_GITHUB_APP_PRIVATE_KEY=
FORGEL_GITHUB_APP_PRIVATE_KEY_PATH=
FORGEL_GITHUB_API_BASE=https://api.github.com
# Default owner for `repo create`/`repo publish` when the project config
# and the command do not set one.
FORGEL_GITHUB_ORG=
