# Local deployment settings for `forgel deploy`. Never commit .env.deploy.
# Everything except DEPLOY_* is written to the remote .env with mode 0600.

# DEPLOY_HOST may be an ~/.ssh/config alias. DEPLOY_USER, DEPLOY_PORT and
# DEPLOY_SSH_KEY are optional: when empty, ssh uses the config, the agent and
# the default key (for example ~/.ssh/id_rsa).
DEPLOY_HOST=example.com
DEPLOY_USER=
DEPLOY_PORT=
DEPLOY_SSH_KEY=
DEPLOY_DIR=/srv/forgel

# Image strategy:
#   auto   - push if DEPLOY_PUSH=true, otherwise build on the server
#   local  - build locally; requires DEPLOY_PUSH=true
#   remote - send the build context and build on the server
DEPLOY_BUILD=auto
DEPLOY_IMAGE=ghcr.io/forgel-dev/forgel:latest
DEPLOY_PUSH=false
# Registry credentials, used for local push and remote pull. Keep this file 0600.
DEPLOY_REGISTRY_USER=
DEPLOY_REGISTRY_TOKEN=
# Optional local GitHub App PEM; uploaded to <DEPLOY_DIR>/secrets/.
DEPLOY_APP_KEY_FILE=

# Runtime configuration for the daemon.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
FORGEL_MODEL_API_KEY=
FORGEL_MODEL_BASE_URL=https://api.deepseek.com/v1
FORGEL_MODEL_NAME=deepseek-flash
FORGEL_GITHUB_TOKEN=
FORGEL_GITHUB_APP_ID=
FORGEL_GITHUB_INSTALLATION_ID=
# Default GitHub owner for repository creation. The App needs Administration
# write; a PAT needs the repository-administration scope.
FORGEL_GITHUB_ORG=
FORGEL_AGENT_MAX_STEPS=24
# Context budget and the number of sessions per coding task.
FORGEL_CONTEXT_WINDOW=1000000
FORGEL_AGENT_MAX_SESSIONS=6
FORGEL_TASK_QA=1
FORGEL_TASK_REVIEW=1
# auto | human
FORGEL_TASK_ACCEPT=human
FORGEL_TASK_RETRIES=2
FORGEL_TASK_REWORKS=2
FORGEL_TASK_ARBITER=1
# quarantine | stop | continue
FORGEL_PLAN_ON_FAILURE=quarantine
# auto uses tiktoken when installed; heuristic forces the fallback.
FORGEL_TOKENIZER=auto
# off_peak (default) holds model work during DeepSeek peak hours (2x rate).
FORGEL_PEAK_POLICY=off_peak
FORGEL_PEAK_HOURS=1-4,6-10
FORGEL_TIMEZONE=
# local = single-tenant, in-process; docker = per-project sandbox.
FORGEL_SANDBOX=local
# Enable the DinD sidecar and the sandbox together:
#   FORGEL_SANDBOX=docker
#   FORGEL_SANDBOX_HOST=tcp://sandbox:2375
#   FORGEL_SANDBOX_PROJECTS_ROOT=/sandbox-data/projects
#   COMPOSE_PROFILES=sandbox
# Or point FORGEL_SANDBOX_HOST at a separate Docker host instead.
# FORGEL_SANDBOX_HOST=
# FORGEL_SANDBOX_PROJECTS_ROOT=
# FORGEL_SANDBOX_IMAGE=
# none | bridge
FORGEL_SANDBOX_NETWORK=none
