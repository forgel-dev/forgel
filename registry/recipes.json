{
  "recipes": [
    {
      "id": "hello-web",
      "version": "0.1.0",
      "kind": "recipe",
      "status": "conformant",
      "description": "Minimal static web app for the M0 skeleton.",
      "composes": [
        "stack-python-stdlib@0.1",
        "frontend-static@0.1",
        "provider-local@0.1",
        "qa-http@0.1"
      ],
      "constraints": {
        "requires": ["web"],
        "supports": [],
        "excludes": ["mobile", "regulated"],
        "regions": ["ru", "eu", "us"]
      },
      "template": "hello-web"
    },
    {
      "id": "django-drf-react",
      "version": "0.1.0",
      "kind": "recipe",
      "status": "conformant",
      "description": "Django REST backend with a React SPA, Postgres and S3-compatible storage.",
      "composes": [
        "stack-django-drf@0.1",
        "frontend-react@0.1",
        "db-postgres@0.1",
        "storage-s3@0.1",
        "provider-yandex@0.1",
        "qa-browser@0.1"
      ],
      "constraints": {
        "requires": ["web", "django", "react", "postgres", "object-storage"],
        "supports": [],
        "excludes": ["mobile", "regulated"],
        "regions": ["ru"]
      },
      "template": "django-drf-react"
    }
  ],
  "presets": [
    {
      "id": "python",
      "description": "Python package: pyproject/setup metadata plus __version__ in the package.",
      "detect": ["pyproject.toml", "setup.py", "setup.cfg", "requirements.txt", "manage.py"],
      "read": [
        {"path": "pyproject.toml", "kind": "toml", "section": "project", "key": "version"},
        {"path": "setup.cfg", "kind": "ini", "section": "metadata", "key": "version"},
        {"path": "VERSION", "kind": "text"},
        {"path": "*/__init__.py", "kind": "regex", "pattern": "(?m)^__version__\\s*=\\s*[\"']([^\"']+)[\"']"},
        {"path": "src/*/__init__.py", "kind": "regex", "pattern": "(?m)^__version__\\s*=\\s*[\"']([^\"']+)[\"']"}
      ],
      "write": [
        {"path": "pyproject.toml", "kind": "toml", "section": "project", "key": "version"},
        {"path": "setup.cfg", "kind": "ini", "section": "metadata", "key": "version"},
        {"path": "VERSION", "kind": "text"},
        {"path": "*/__init__.py", "kind": "regex", "pattern": "(?m)^__version__\\s*=\\s*[\"']([^\"']+)[\"']", "replacement": "__version__ = \"{version}\""},
        {"path": "src/*/__init__.py", "kind": "regex", "pattern": "(?m)^__version__\\s*=\\s*[\"']([^\"']+)[\"']", "replacement": "__version__ = \"{version}\""}
      ]
    },
    {
      "id": "node",
      "description": "Node package or workspace: the root and app package manifests.",
      "detect": ["package.json"],
      "read": [
        {"path": "package.json", "kind": "json", "key": "version"},
        {"path": "apps/*/package.json", "kind": "json", "key": "version"}
      ],
      "write": [
        {"path": "package.json", "kind": "json", "key": "version"},
        {"path": "apps/*/package.json", "kind": "json", "key": "version"}
      ]
    },
    {
      "id": "rails",
      "description": "Rails application: API_VERSION in the version initializer.",
      "detect": ["Gemfile"],
      "read": [
        {"path": "config/initializers/version.rb", "kind": "ruby", "key": "API_VERSION"}
      ],
      "write": [
        {"path": "config/initializers/version.rb", "kind": "ruby", "key": "API_VERSION"}
      ]
    }
  ]
}
